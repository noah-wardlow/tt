{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tt-server",
	"compatibility_date": "2026-05-27",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./src/index.ts",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tt-database",
			"database_id": "51a434c1-0270-49ba-a47e-81dca87b5756"
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	// For local development, create a .dev.vars file with your secrets
	// For production, use: wrangler secret put VARIABLE_NAME
	"vars": {
		"BETTER_AUTH_URL": "https://tt-server.nmwardlow.workers.dev",
		"APP_ORIGIN": "https://tt-client.nmwardlow.workers.dev"
	}
}
